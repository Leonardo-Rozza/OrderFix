# Toda variable VITE_* queda embebida y es pública en el bundle del navegador.
# Nunca guardes tokens, contraseñas ni secretos en este archivo.

# URL base del backend OrdenFix (sin /api: el frontend lo agrega solo).
# Local:      http://localhost:8080
# Producción: https://tu-backend.com
VITE_API_BASE_URL=http://localhost:8080

# Contactos públicos obligatorios antes de un release abierto.
VITE_LEGAL_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_SUPPORT_EMAIL=

# Monitoreo de errores con Sentry (opcional). Si se deja vacío, Sentry no se
# inicializa (no-op total). Pegá el DSN del proyecto para activarlo en producción.
VITE_SENTRY_DSN=

# Configuración transitoria de la subida unsigned actual. El guard público la
# bloquea hasta migrar a uploads privados autorizados por el backend.
VITE_CLOUDINARY_CLOUD_NAME=dnd9rnidg
VITE_CLOUDINARY_UPLOAD_PRESET=ordenfix_unsigned

# Ruta versionada del manifiesto legal inmutable. Es una variable del proceso de
# build (no VITE_*) y debe apuntar dentro de docs/legal/publications/<id>/.
ORDENFIX_LEGAL_PUBLICATION_MANIFEST=

{
  "name": "ordenfix-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-public-release.mjs --if-deploy && tsc -b && vite build && node scripts/check-public-release.mjs --artifacts-if-deploy",
    "build:public": "node scripts/check-public-release.mjs --force && tsc -b && vite build && node scripts/check-public-release.mjs --artifacts",
    "check:public-release": "node scripts/check-public-release.mjs --force",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm run test:release",
    "test:release": "node --test scripts/check-public-release.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:registration-real": "node scripts/run-registration-real.mjs",
    "test:e2e:photos-real": "node scripts/run-photos-real.mjs",
    "test:e2e:export-real": "node scripts/run-export-real.mjs",
    "typecheck": "tsc -b --noEmit",
    "test:e2e:closure-real": "node scripts/run-closure-real.mjs"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.59.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "react-router": "^7.9.6",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "mdast-util-from-markdown": "2.0.3",
    "msw": "^2.14.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.6"
  }
}
